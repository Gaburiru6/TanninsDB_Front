# ========================================================
# TANNINSDB FRONTEND - MODELO DE CONFIGURAÇÃO DE AMBIENTE
# ========================================================
# Copie este arquivo para .env e ajuste os valores conforme o ambiente:
# cp .env.example .env
# ========================================================

# Porta exposta no Host para o Nginx
FRONT_PORT=80

# URL da API Backend que o frontend consumirá no navegador
# Exemplos:
# - Servidor de Desenvolvimento: https://tanninsapi-dev.murasaki.sbs ou http://IP_DO_SERVIDOR:8081
# - Servidor de Produção: https://tanninsapi.murasaki.sbs
API_URL=https://tanninsapi.murasaki.sbs
